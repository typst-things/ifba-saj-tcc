// assets/algoritmos/busca.typ — Algoritmo estruturado (pseudocódigo).

#let busca-linear = (
  [*procedure* BuscaLinear(lista, alvo)],
  [  #h(1em) *para cada* elemento *em* lista *faça*],
  [    #h(2em) *se* elemento == alvo *então*],
  [      #h(3em) *retorne* true],
  [  #h(1em) *retorne* false],
  [*fim procedure*],
)